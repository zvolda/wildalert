# Copy this file to `.env` and fill in real values. `.env` is git-ignored — never commit it.
# For local dev these can be anything, as long as compose.yml and the app agree.

# --- Postgres (local dev, read by compose.yml and the services) ---
POSTGRES_USER=wildalert
POSTGRES_PASSWORD=change-me-local-dev
POSTGRES_DB=wildalert
DATABASE_URL=jdbc:postgresql://localhost:5432/wildalert

# --- Cloud Pub/Sub (local dev, matches compose.yml) ---
# Prefer the Spring profile over EVENTS_PROVIDER for the Kotlin services — it switches the provider
# and the GCP auto-configuration together:  SPRING_PROFILES_ACTIVE=pubsub
# 'pubsub' turns on publishing (email-ingestion) and the push endpoint (notification).
# Unset = the logging fakes, and no broker is needed at all.
EVENTS_PROVIDER=
# The emulator's project. Java needs this as a Spring property, hence the long name.
SPRING_CLOUD_GCP_PROJECT_ID=wildalert-local
# Emulator address. The Java client ignores the standard PUBSUB_EMULATOR_HOST, so the Kotlin
# services need this Spring-specific variable; setting it also activates PubSubCredentialsConfig,
# which is why it must stay unset in the cloud.
SPRING_CLOUD_GCP_PUBSUB_EMULATOR_HOST=localhost:8085
# The Python service honours the standard variables (reference only — it reads real env vars).
PUBSUB_EMULATOR_HOST=localhost:8085
PUBSUB_PROJECT_ID=wildalert-local
RECOGNITION_EVENTS_PROVIDER=logging
# Notification looks up hunters' phone numbers here
USER_ACCOUNT_BASE_URL=http://localhost:8081
# How notification authenticates to user-account: 'none' locally, 'gcp-id-token' on Cloud Run
# (user-account is deployed with Require authentication, so calls need an ID token for its URL).
# email-ingestion no longer calls user-account at all -- the recipient travels on the event.
USER_ACCOUNT_AUTH=none

# --- Hunters' personal inbound addresses (<token>@<domain>), user-account ---
# In prod: the apex of the Cloudflare Email Routing zone, e.g. wildalert.app. Not a
# subdomain -- Cloudflare allows a catch-all only on the apex (see deploy/email-worker/).
INBOUND_EMAIL_DOMAIN=wildalert.local

# --- Hunter logins (user-account) ---
# How long a session lasts. Absolute, not sliding -- a sliding window would mean a database write
# on every authenticated request.
SESSION_TTL_DAYS=30
# Name of the session cookie. Rarely worth changing; here so it is discoverable.
SESSION_COOKIE_NAME=wa_session
# **false locally, true on Cloud Run.** A `Secure` cookie is silently not set over plain http, so
# true here would make the login on http://localhost:5173 look like it does nothing at all -- no
# error, no cookie, straight back to the form. Everything in the cloud is https, so set
# SESSION_COOKIE_SECURE=true on the revision.
SESSION_COOKIE_SECURE=false

# --- What one alert costs a hunter (user-account) ---
# Shown on the dashboard as "about N alerts left": recognition (100) + SMS (150), in haléře.
# Known duplication: notification owns billing.sms-cost-minor and recognition will own its own
# debit. Those are the internal amounts charged; this is the hunter-facing price. Consolidate when
# recognition starts charging.
ALERT_PRICE_MINOR=250

# --- Email webhook authentication (email-ingestion) ---
# Shared secret Cloudflare's Email Worker must send. Empty = endpoint open (local dev only).
WEBHOOK_SECRET=
WEBHOOK_HEADER_NAME=X-Webhook-Secret

# --- Image storage (email-ingestion writes, recognition reads by storage key) ---
# 'logging' (fake, stores nothing), 'filesystem' (local folder) or 'r2'
STORAGE_PROVIDER=logging
STORAGE_FILESYSTEM_ROOT=data/images
# Cloudflare R2 (S3 API) — only for STORAGE_PROVIDER=r2 / RECOGNITION_IMAGE_SOURCE=r2
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY=
R2_SECRET_KEY=
# Recognition service: 'local' (reads RECOGNITION_IMAGE_ROOT) or 'r2'.
# Reference only — the Python service reads real env vars, not this file.
RECOGNITION_IMAGE_SOURCE=local
RECOGNITION_IMAGE_ROOT=../../data/images

# --- Duplicate protection (notification service) ---
# 'memory' (fake, default — per-instance, lost on restart) or 'postgres' (shared, durable).
# 'postgres' reuses DATABASE_URL/POSTGRES_USER/POSTGRES_PASSWORD above, in its own schema.
IDEMPOTENCY_STORE=memory

# --- SMS (notification service) ---
SMS_PROVIDER=logging            # 'logging' (fake) or 'twilio'
# GoSMS (gosms.eu) -- Czech SMS gateway, no monthly fee. Only for SMS_PROVIDER=gosms.
# client id/secret come from the GoSMS admin panel; GOSMS_CHANNEL is the numeric channel id.
GOSMS_CLIENT_ID=
GOSMS_CLIENT_SECRET=
GOSMS_CHANNEL=
# Guarding *our* prepaid balance at the gateway (notification reads it from GoSMS's GET /api/v1/).
# All three have working defaults -- set them only to change the numbers, not to switch the guard
# on. Unlike the hunter-facing prices, a wrong value here cannot give credit away; it can only
# block alerts, which is why an unreadable balance never blocks and the defaults are modest.
SMS_PROVIDER_MESSAGE_PRICE_MINOR=120    # what one message costs us, haléře (GoSMS-test channel)
SMS_PROVIDER_CREDIT_WARN_MINOR=2000     # log a warning at or below 20 CZK (~16 messages)
SMS_PROVIDER_CREDIT_TTL=5m              # how long a healthy balance is trusted before re-reading

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SENDER_ID=WildAlert
