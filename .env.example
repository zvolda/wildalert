# Copy this file to `.env` and fill in real values. `.env` is git-ignored — never commit it.
# For local dev these can be anything, as long as compose.yml and the app agree.

# --- Postgres (local dev, read by compose.yml and the services) ---
POSTGRES_USER=wildalert
POSTGRES_PASSWORD=change-me-local-dev
POSTGRES_DB=wildalert
DATABASE_URL=jdbc:postgresql://localhost:5432/wildalert

# --- Kafka (local dev, matches compose.yml) ---
KAFKA_BOOTSTRAP_SERVERS=localhost:29092
