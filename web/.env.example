# Copy to .env.local (git-ignored by the repo's `*.local` rule) to override.
#
# Where the dev server forwards /api/* requests. Only the Vite dev server reads this -- it is
# not compiled into the bundle, because in production the gateway serves the UI and the API
# from the same origin, so there is nothing to point at.
VITE_API_PROXY_TARGET=http://localhost:8081
